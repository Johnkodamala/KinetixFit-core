# RevenueCat public SDK keys (client-side, safe to be visible in the shipped app).
# Get these from the RevenueCat dashboard: Project Settings -> API Keys -> Public app-specific key.
# These are DIFFERENT from the secret REVENUECAT_API_KEY used server-side in api/verify-license.js.
#
# Copy this file to .env (or .env.local) and fill in real values. .env is gitignored.
VITE_REVENUECAT_IOS_PUBLIC_KEY=
VITE_REVENUECAT_ANDROID_PUBLIC_KEY=

# Server-side secrets used by api/scan-meal.js (Vercel serverless function).
# Never VITE_-prefix these — they must not be bundled into the client.
# ANTHROPIC_API_KEY: from console.anthropic.com, used for the photo food-identification step.
# USDA_FDC_API_KEY: free key from api.data.gov/signup, used for the nutrition-facts lookup.
ANTHROPIC_API_KEY=
USDA_FDC_API_KEY=

# Server-side secrets used by api/redeem-promo.js.
# REVENUECAT_API_KEY: the same secret key api/verify-license.js already uses (Project Settings -> API Keys -> Secret key).
# PROMO_CODES_JSON: your real promo codes, e.g. {"KINETIX-FAMILY-01":"lifetime","KINETIX-INFLUENCER-42":"30day"}
#   Valid tiers: "lifetime" or "30day". Never put real codes in a committed file — set this directly in Vercel.
REVENUECAT_API_KEY=
PROMO_CODES_JSON=

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN: used by api/redeem-promo.js to track which
# promo codes have already been redeemed. Don't fill these in by hand — provision a Redis database
# via the Vercel Marketplace (Storage tab -> Create Database -> Redis) and Vercel injects these
# automatically once it's connected to this project.
