<?xml version="1.0" encoding="utf-8"?>
<!-- Daily rings (2x2): steps, water and food as gradient rings inside each other, a compact legend below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="vertical" android:padding="14dp">
    <ImageView android:id="@+id/rings" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:scaleType="fitCenter" android:src="@drawable/widget_preview_rings" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_steps" android:tint="#FF6E9EFF"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/steps_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="6,240" android:textSize="12sp" android:fontFamily="@font/kx_text_bold"
                android:textColor="@color/kx_glass_ink" android:maxLines="1" />
            <TextView android:id="@+id/steps_goal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="3dp" android:text="/ 10k" android:textSize="11sp" android:fontFamily="@font/kx_text"
                android:textColor="@color/kx_glass_ink_3" android:maxLines="1" />
        </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_drop" android:tint="#FF3FC9E4"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/water_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="2" android:textSize="12sp" android:fontFamily="@font/kx_text_bold"
                android:textColor="@color/kx_glass_ink" android:maxLines="1" />
            <TextView android:id="@+id/water_goal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="3dp" android:text="/ 6" android:textSize="11sp" android:fontFamily="@font/kx_text"
                android:textColor="@color/kx_glass_ink_3" android:maxLines="1" />
        </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_widget_flame" android:tint="#FFFF8A5C"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/food_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:text="1,240" android:textSize="12sp" android:fontFamily="@font/kx_text_bold"
                android:textColor="@color/kx_glass_ink" android:maxLines="1" />
            <TextView android:id="@+id/food_goal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="3dp" android:text="/ 2,100 kcal" android:textSize="11sp" android:fontFamily="@font/kx_text"
                android:textColor="@color/kx_glass_ink_3" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
