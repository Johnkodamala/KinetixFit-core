<?xml version="1.0" encoding="utf-8"?>
<!-- Streak in the widget picker (widget_streak.xml draws its number and dots as bitmaps, which a preview can't). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_chip_flame" android:padding="5dp"
            android:src="@drawable/ic_widget_flame" android:tint="@color/kx_streak" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="STREAK"
            android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="@color/kx_glass_ink_2" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:text="12" android:textSize="44sp" android:textStyle="bold" android:textColor="@color/kx_streak" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="day streak · M T W T F S S"
        android:textSize="12sp" android:textColor="@color/kx_glass_ink_3" android:maxLines="1" />
</LinearLayout>
