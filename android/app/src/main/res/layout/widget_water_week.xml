<?xml version="1.0" encoding="utf-8"?>
<!-- Water this week (4x2): header with a glossy +, today's count + goal days beside seven bars in tracks (WidgetArt.trackBars). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_chip"
            android:padding="5dp" android:src="@drawable/ic_widget_drop" android:tint="@color/kx_glass_water" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="WATER · THIS WEEK" android:textSize="11sp" android:fontFamily="@font/kx_text_bold"
            android:letterSpacing="0.12" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
        <TextView android:id="@+id/add_glass" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/widget_btn_water_round" android:gravity="center" android:includeFontPadding="false"
            android:text="+" android:textSize="20sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF"
            android:contentDescription="Add a glass of water" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginEnd="16dp"
            android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/count_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="750 ml" android:textSize="38sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" android:maxLines="1" />
        <ImageView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitStart" android:tint="@color/kx_glass_ink" android:visibility="gone" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="glasses today" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/widget_status_pill" android:paddingHorizontal="9dp"
            android:paddingVertical="3dp" android:text="Goal met 3/7" android:textSize="11sp" android:fontFamily="@font/kx_text_bold"
            android:textColor="@color/kx_glass_water" android:maxLines="1" />
        </LinearLayout>
        <ImageView android:id="@+id/bars" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/widget_preview_bars" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
