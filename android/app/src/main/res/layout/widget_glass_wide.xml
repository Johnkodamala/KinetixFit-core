<?xml version="1.0" encoding="utf-8"?>
<!-- Water glass, wide (4x2): header | the tumbler, the amount with "of 2 L · 3 glasses to go" and the next reminder, the
     glossy water +. See widget_glass.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_clip" android:clipToOutline="true">
    <ImageView android:id="@+id/glass" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/widget_preview_frost" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/chip_icon" android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_glass_chip"
                android:padding="5dp" android:src="@drawable/ic_widget_drop" android:tint="@color/kx_glass_water" android:importantForAccessibility="no" />
            <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="WATER" android:textSize="11sp" android:fontFamily="@font/kx_text_bold"
                android:letterSpacing="0.12" android:textColor="@color/kx_lg_ink_2" android:maxLines="1" />
            <TextView android:id="@+id/percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="63%" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="@color/kx_glass_water"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/tumbler" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/widget_preview_tumbler"
                android:contentDescription="Water glass" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_marginEnd="12dp" android:orientation="vertical">
                <TextView android:id="@+id/count_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1.25 L" android:textSize="34sp" android:textStyle="bold" android:textColor="@color/kx_lg_ink" android:maxLines="1" />
                <ImageView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:adjustViewBounds="true" android:scaleType="fitStart" android:tint="@color/kx_lg_ink" android:visibility="gone" />
                <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="of 2 L · 3 glasses to go" android:textSize="13sp" android:fontFamily="@font/kx_text_bold"
                    android:textColor="@color/kx_lg_ink_2" android:maxLines="1" />
                <TextView android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="Next 14:00" android:textSize="12sp" android:fontFamily="@font/kx_text"
                    android:textColor="@color/kx_lg_ink_2" android:maxLines="1" />
            </LinearLayout>
            <TextView android:id="@+id/add_glass" android:layout_width="46dp" android:layout_height="46dp"
                android:background="@drawable/widget_btn_water_round" android:gravity="center" android:includeFontPadding="false"
                android:text="+" android:textSize="24sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF"
                android:contentDescription="Add a glass of water" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
