<?xml version="1.0" encoding="utf-8"?>
<!-- Streak, one row high (2x1 / 4x1): flame, number, "day streak" and (when wide) the dots. StreakWidget.java -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/widget_chip_flame"
        android:padding="6dp" android:src="@drawable/ic_widget_flame" android:tint="@color/kx_streak" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
        android:adjustViewBounds="true" android:tint="@color/kx_streak" android:importantForAccessibility="no" />
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
        android:text="day streak" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="@color/kx_glass_ink_2" android:maxLines="2" />
    <ImageView android:id="@+id/dots" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:adjustViewBounds="true" android:scaleType="fitEnd" android:importantForAccessibility="no" />
</LinearLayout>
