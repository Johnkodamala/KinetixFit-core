<?xml version="1.0" encoding="utf-8"?>
<!-- Water quick add (4x1): header + count + a glowing bar, then glossy + Glass (250 ml) and glass + Bottle (500 ml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_chip"
            android:padding="5dp" android:src="@drawable/ic_widget_drop" android:tint="@color/kx_glass_water" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="WATER" android:textSize="11sp" android:fontFamily="@font/kx_text_bold"
            android:letterSpacing="0.12" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="500 ml" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
    </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/count_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="750 ml" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" android:maxLines="1" />
        <ImageView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitStart" android:tint="@color/kx_glass_ink" android:visibility="gone" />
        <TextView android:id="@+id/of" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="glasses" android:textSize="12sp" android:fontFamily="@font/kx_text" android:textColor="@color/kx_glass_ink_3" android:maxLines="1" android:layout_marginStart="6dp" />
        </LinearLayout>
        <ImageView android:id="@+id/bar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitXY" android:src="@drawable/widget_preview_bar"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <TextView android:id="@+id/add_round" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone"
        android:background="@drawable/widget_btn_water_round" android:gravity="center" android:includeFontPadding="false"
        android:text="+" android:textSize="24sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF"
        android:contentDescription="Add a glass of water" />
    <LinearLayout android:id="@+id/add_glass" android:layout_width="wrap_content" android:layout_height="54dp"
        android:minWidth="76dp" android:background="@drawable/widget_btn_water" android:orientation="horizontal" android:gravity="center"
        android:paddingHorizontal="12dp" android:contentDescription="Add a glass of water, 250 ml">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_drop" android:tint="#FFFFFFFF"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Glass"
                android:textSize="13sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/glass_ml" android:text="250 ml"
                android:textSize="10sp" android:fontFamily="@font/kx_text" android:textColor="#E6FFFFFF" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/add_bottle" android:layout_width="wrap_content" android:layout_height="54dp" android:layout_marginStart="8dp"
        android:minWidth="76dp" android:background="@drawable/widget_btn_soft" android:orientation="horizontal" android:gravity="center"
        android:paddingHorizontal="12dp" android:contentDescription="Add a bottle of water, 500 ml">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_bottle" android:tint="@color/kx_glass_water"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bottle"
                android:textSize="13sp" android:fontFamily="@font/kx_text_bold" android:textColor="@color/kx_glass_water" android:maxLines="1" />
            <TextView android:id="@+id/bottle_ml" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500 ml"
                android:textSize="10sp" android:fontFamily="@font/kx_text" android:textColor="@color/kx_glass_ink_3" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
