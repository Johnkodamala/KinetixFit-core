<?xml version="1.0" encoding="utf-8"?>
<!-- Water ring, wide (4x2): ring with % | header, count, amount + next, glossy Add a glass. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
    <FrameLayout android:layout_width="wrap_content" android:layout_height="match_parent">
        <ImageView android:id="@+id/ring" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/widget_preview_ring"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/percent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="33%" android:textSize="18sp" android:fontFamily="@font/kx_text_bold"
            android:textColor="@color/kx_glass_ink" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_chip"
            android:padding="5dp" android:src="@drawable/ic_widget_drop" android:tint="@color/kx_glass_water" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="WATER" android:textSize="11sp" android:fontFamily="@font/kx_text_bold"
            android:letterSpacing="0.12" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
        
    </LinearLayout>
        <TextView android:id="@+id/count_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="750 ml" android:textSize="34sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" android:maxLines="1" />
        <ImageView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitStart" android:tint="@color/kx_glass_ink" android:visibility="gone" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="500 ml of 1.5 L · Next 17:00" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
        <TextView android:id="@+id/add_glass" android:layout_width="wrap_content" android:layout_height="42dp"
            android:layout_marginTop="12dp" android:paddingHorizontal="18dp" android:background="@drawable/widget_btn_water"
            android:gravity="center" android:text="+  Add a glass" android:textSize="14sp" android:fontFamily="@font/kx_text_bold"
            android:textColor="#FFFFFFFF" android:contentDescription="Add a glass of water" />
    </LinearLayout>
</LinearLayout>
