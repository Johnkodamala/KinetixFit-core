<?xml version="1.0" encoding="utf-8"?>
<!-- Quick log (Plus, 4x2 / 4x1): the buttons in one row, and what was logged last. QuickLogWidget.java -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/chip" android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_chip"
            android:padding="5dp" android:src="@drawable/ic_widget_plus" android:tint="@color/kx_glass_water" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="QUICK LOG" android:textSize="11sp" android:fontFamily="@font/kx_text_bold"
            android:letterSpacing="0.12" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
        <TextView android:id="@+id/water" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="750 ml" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="@color/kx_glass_water" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/btn1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_theme_ocean" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/btn1_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_drop"
                android:tint="#FFFFFFFF" android:importantForAccessibility="no" />
            <TextView android:id="@+id/btn1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="250 ml" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btn2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_theme_ocean" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/btn2_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_drop"
                android:tint="#FFFFFFFF" android:importantForAccessibility="no" />
            <TextView android:id="@+id/btn2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="250 ml" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btn3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_theme_ocean" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/btn3_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_drop"
                android:tint="#FFFFFFFF" android:importantForAccessibility="no" />
            <TextView android:id="@+id/btn3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="250 ml" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btn4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:background="@drawable/widget_btn_theme_ocean" android:orientation="vertical" android:gravity="center" android:padding="4dp">
            <ImageView android:id="@+id/btn4_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_drop"
                android:tint="#FFFFFFFF" android:importantForAccessibility="no" />
            <TextView android:id="@+id/btn4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="250 ml" android:textSize="12sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/last" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="Tap a button to log it" android:textSize="11sp" android:fontFamily="@font/kx_text" android:textColor="@color/kx_glass_ink_3" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
