<?xml version="1.0" encoding="utf-8"?>
<!-- Water this week, square (2x2): header with +, count, seven bars, goal days. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_chip"
            android:padding="5dp" android:src="@drawable/ic_widget_drop" android:tint="@color/kx_glass_water" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="THIS WEEK" android:textSize="11sp" android:fontFamily="@font/kx_text_bold"
            android:letterSpacing="0.12" android:textColor="@color/kx_glass_ink_2" android:maxLines="1" />
        <TextView android:id="@+id/add_glass" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/widget_btn_water_round" android:gravity="center" android:includeFontPadding="false"
            android:text="+" android:textSize="20sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF"
            android:contentDescription="Add a glass of water" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/count_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="750 ml" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" android:maxLines="1" />
        <ImageView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitStart" android:tint="@color/kx_glass_ink" android:visibility="gone" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="· 3/7 days" android:textSize="12sp" android:fontFamily="@font/kx_text" android:textColor="@color/kx_glass_ink_3" android:maxLines="1" android:layout_marginStart="8dp" />
    </LinearLayout>
    <ImageView android:id="@+id/bars" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:scaleType="fitXY" android:src="@drawable/widget_preview_bars"
        android:importantForAccessibility="no" />
</LinearLayout>
