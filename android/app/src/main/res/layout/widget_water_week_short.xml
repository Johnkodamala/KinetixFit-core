<?xml version="1.0" encoding="utf-8"?>
<!-- Water this week, short (2x1 / 4x1): count + goal days | seven bars (when wide enough) | round +. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginEnd="12dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="THIS WEEK" android:textSize="10sp" android:fontFamily="@font/kx_text_bold" android:letterSpacing="0.12"
            android:textColor="@color/kx_glass_water" android:maxLines="1" />
        <TextView android:id="@+id/count_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="750 ml" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" android:maxLines="1" />
        <ImageView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitStart" android:tint="@color/kx_glass_ink" android:visibility="gone" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0/7 days" android:textSize="11sp" android:fontFamily="@font/kx_text" android:textColor="@color/kx_glass_ink_3" android:maxLines="1" />
    </LinearLayout>
    <ImageView android:id="@+id/bars" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:layout_marginEnd="12dp" android:scaleType="fitXY" android:src="@drawable/widget_preview_bars" android:importantForAccessibility="no" />
    <TextView android:id="@+id/add_glass" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/widget_btn_water_round" android:gravity="center" android:includeFontPadding="false"
        android:text="+" android:textSize="22sp" android:fontFamily="@font/kx_text_bold" android:textColor="#FFFFFFFF"
        android:contentDescription="Add a glass of water" />
</LinearLayout>
