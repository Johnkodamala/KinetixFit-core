<?xml version="1.0" encoding="utf-8"?>
<!-- My stats in the widget picker (the widget draws its numbers as bitmaps, which a preview can't). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_glass" android:clipToOutline="true" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/widget_chip" android:padding="5dp"
            android:src="@drawable/ic_widget_trophy" android:tint="@color/kx_glass_water" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="MY STATS"
            android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="@color/kx_glass_ink_2" />
    </LinearLayout>
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:columnCount="2" android:layout_gravity="bottom">
        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6,842" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="steps" android:textSize="11sp" android:textColor="@color/kx_glass_ink_3" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.5 L" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="water" android:textSize="11sp" android:textColor="@color/kx_glass_ink_3" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,240" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="kcal left" android:textSize="11sp" android:textColor="@color/kx_glass_ink_3" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/kx_glass_ink" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="day streak" android:textSize="11sp" android:textColor="@color/kx_glass_ink_3" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>
