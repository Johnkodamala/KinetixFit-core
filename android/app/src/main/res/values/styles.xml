<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Shows behind the system bars if the WebView can't draw there itself (older WebViews) -->
        <item name="android:windowBackground">@color/kx_app_bg</item>
    </style>


    <!-- Plain launch colour with no icon: the web launch intro (src/components/LaunchIntro.tsx) draws
         the mark itself, so the system splash only needs to hold the colour until the WebView paints. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/kx_launch_bg</item>
        <item name="android:windowBackground">@color/kx_launch_bg</item>
        <item name="windowSplashScreenBackground">@color/kx_launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>