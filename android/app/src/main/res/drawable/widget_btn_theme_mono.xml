<?xml version="1.0" encoding="utf-8"?>
<!-- Quick log button in the "mono" colour (WidgetThemes.java): one gradient, lighter at the top, and a hairline edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient android:angle="270" android:startColor="#FF9AA7AF" android:endColor="#FF4E5E67" />
    <stroke android:width="1dp" android:color="#40FFFFFF" />
</shape>
