<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the widget gallery (WidgetGalleryReceiver) — renders every widget to a PNG for checking. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".WidgetGalleryReceiver" android:exported="true"
            tools:ignore="ExportedReceiver" xmlns:tools="http://schemas.android.com/tools">
            <intent-filter><action android:name="com.jnglobalventures.kinetixfit.RENDER_WIDGETS" /></intent-filter>
        </receiver>
    </application>
</manifest>
